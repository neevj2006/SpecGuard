# Local-only API. Keep the service bound to 127.0.0.1.
SPECGUARD_REPOSITORY_ROOT=.
SPECGUARD_DATABASE=.specguard/runs.sqlite3
# Optional PostgreSQL URL; run `uv run alembic upgrade head` before deployment.
SPECGUARD_DATABASE_URL=
# A stable identifier decouples workspace ownership from token rotation.
SPECGUARD_OWNER_ID=local
# Generate a random token before starting the API.
SPECGUARD_API_TOKEN=
# Optional: source is sent to the provider only when model mode is selected.
SPECGUARD_MODEL=
SPECGUARD_MODEL_KEY=
# GitHub App keys stay outside the repository. Installation tokens are ephemeral.
SPECGUARD_GITHUB_APP_ID=
SPECGUARD_GITHUB_PRIVATE_KEY_FILE=
SPECGUARD_GITHUB_INSTALLATIONS=
SPECGUARD_GITHUB_WEBHOOK_SECRET=
